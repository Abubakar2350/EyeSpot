# Dockerfile for a PUBLIC Space whose source code stays PRIVATE.
#
# The Space repository is public, so anyone with the link can use the demo — but
# the only file in it is this Dockerfile. The application itself is cloned at
# build time from a private GitHub repository, using a token supplied as a Space
# secret. Hugging Face does not expose a Space's built image, so visitors get the
# running app and never the source.
#
# Requires a Space secret named GITHUB_TOKEN with read access to the repository.

FROM python:3.11-slim

# ffmpeg powers the H.264 transcode that makes result videos playable in the
# browser; git is needed to fetch the private source.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg git \
    && rm -rf /var/lib/apt/lists/*

# Spaces run the container as uid 1000, so build for that user from the start
RUN useradd -m -u 1000 user
WORKDIR /app
RUN chown -R user:user /app
USER user

ENV PATH="/home/user/.local/bin:$PATH"
ENV HOME=/home/user
ENV PYTHONUNBUFFERED=1

# Ultralytics and matplotlib both need a writable config directory
ENV YOLO_CONFIG_DIR=/home/user/.config/Ultralytics
ENV MPLCONFIGDIR=/home/user/.cache/matplotlib

# Tells the app it is hosted, so the live camera tab explains itself instead of
# failing to reach a camera it could never see from here
ENV EYESPOT_CLOUD=1
ENV STREAMLIT_SERVER_HEADLESS=true

ARG GITHUB_REPO=Abubakar2350/EyeSpot

# The token is mounted as a BuildKit secret, so it never becomes an image layer
# and cannot be recovered from the built image. Removing .git afterwards also
# clears the credential that git would otherwise cache in .git/config.
RUN --mount=type=secret,id=GITHUB_TOKEN,mode=0444,required=true \
    git clone --depth 1 \
      "https://$(cat /run/secrets/GITHUB_TOKEN)@github.com/${GITHUB_REPO}.git" /app \
    && rm -rf /app/.git

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r deploy/requirements-hf.txt

EXPOSE 7860

CMD ["streamlit", "run", "ui/streamlit_app.py", \
     "--server.port=7860", "--server.address=0.0.0.0"]
