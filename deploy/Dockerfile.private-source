# Dockerfile for a PUBLIC Space whose source code stays PRIVATE.
#
# The Space repository is public, so anyone with the link can use the demo — but
# the only file in it is this Dockerfile. The application itself is cloned at
# build time from a private GitHub repository. Hugging Face never exposes a
# Space's built image, so visitors get the running app and never the source.
#
# Requires a Space secret named SSH_DEPLOY_KEY holding a GitHub **deploy key**
# for the repository. A deploy key is scoped to one repository and can be marked
# read-only, which is why it is used here rather than a personal access token —
# a PAT would carry access to every repository the account owns.

FROM python:3.11-slim

# ffmpeg powers the H.264 transcode that makes result videos playable in the
# browser; git and openssh-client fetch the private source.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg git openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Spaces run the container as uid 1000, so build for that user from the start
RUN useradd -m -u 1000 user
WORKDIR /app
RUN chown -R user:user /app
USER user

ENV PATH="/home/user/.local/bin:$PATH"
ENV HOME=/home/user
ENV PYTHONUNBUFFERED=1

# Ultralytics and matplotlib both need a writable config directory
ENV YOLO_CONFIG_DIR=/home/user/.config/Ultralytics
ENV MPLCONFIGDIR=/home/user/.cache/matplotlib

# Tells the app it is hosted, so the live camera tab explains itself instead of
# failing to reach a camera it could never see from here
ENV EYESPOT_CLOUD=1
ENV STREAMLIT_SERVER_HEADLESS=true

ARG GITHUB_REPO=Abubakar2350/EyeSpot

# The key is a BuildKit secret, so it is never written into an image layer. It
# is copied to a private-mode file because ssh refuses a key it considers
# world-readable, then deleted inside the same layer along with .git, which
# would otherwise retain the remote credentials.
RUN --mount=type=secret,id=SSH_DEPLOY_KEY,mode=0444 \
    mkdir -p /home/user/.ssh \
    && cp /run/secrets/SSH_DEPLOY_KEY /home/user/.ssh/deploy_key \
    && chmod 600 /home/user/.ssh/deploy_key \
    && ssh-keyscan -t ed25519 github.com >> /home/user/.ssh/known_hosts 2>/dev/null \
    && GIT_SSH_COMMAND="ssh -i /home/user/.ssh/deploy_key -o IdentitiesOnly=yes" \
       git clone --depth 1 "git@github.com:${GITHUB_REPO}.git" /app \
    && rm -f /home/user/.ssh/deploy_key \
    && rm -rf /app/.git

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r deploy/requirements-hf.txt

EXPOSE 7860

CMD ["streamlit", "run", "ui/streamlit_app.py", \
     "--server.port=7860", "--server.address=0.0.0.0"]
